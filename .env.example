# watsonx credentials for the Granite explanation layer.
#
# Names only. Copy to .env and fill in; .env is gitignored and must never be
# committed. Nothing here is required: with these unset, agent/explain.py
# serves the deterministic floor and reports served_by=deterministic_floor.
# That is the path a user with no IBM account gets, and it is a design gate
# rather than a fallback, so it stays working.

# Required for the Granite path. Both must be set or the client is not built.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Optional. Defaults live in agent/granite.py: us-south, ibm/granite-4-h-small,
# and the dated ml/v1 API version.
WATSONX_URL=
WATSONX_MODEL_ID=
WATSONX_API_VERSION=
